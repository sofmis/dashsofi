# Copia a .env y edita. Nunca subas .env a Git.

# ---- Modo ----------------------------------------------------------------
# full   = instalación completa (local): escaneos activos sobre ALLOWED_TARGETS.
# public = página pública (Fase A): cuentas + reputación de URLs. Escaneo activo desactivado.
MODE=full
ENABLE_ACTIVE_SCANS=true
# Clave de administrador por cabecera X-API-Key. En una instalación pública déjala VACÍA.
API_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# ---- Base de datos (PostgreSQL) --------------------------------------------
POSTGRES_PASSWORD=cambia-esta-clave-de-base
DATABASE_URL=postgresql://vs:${POSTGRES_PASSWORD}@db:5432/vs

# ---- Cuentas y sesiones ----------------------------------------------------
PUBLIC_URL=http://127.0.0.1:8000
COOKIE_SECURE=0            # 1 en producción (HTTPS)
TRUST_PROXY=0              # 1 detrás de Render/Fly (usa la IP real del cliente)
SESSION_DAYS=14
REP_DAILY_LIMIT=30         # consultas de reputación por usuario y día
REP_GLOBAL_DAILY_LIMIT=400 # consultas reales (no caché) por día para toda la página; VirusTotal gratis ≈ 500/día

# Correo (verificación y recuperación). Sin SMTP_HOST el servidor se niega a enviar,
# salvo MAIL_DEV=1 (solo desarrollo: el enlace aparece en el log).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=VulnerScan <no-reply@tu-dominio.com>
MAIL_DEV=0

# ---- Escaneo activo (solo MODE=full) ----------------------------------------
# SOLO activos que POSEES o tienes autorización escrita para auditar.
ALLOWED_TARGETS=scanme.nmap.org,testphp.vulnweb.com
MAX_HOSTS=256
NVD_API_KEY=

# ---- Reputación de URLs -----------------------------------------------------
# Sin estas claves la fuente aparece como 'sin clave'.
VT_API_KEY=
GSB_API_KEY=
